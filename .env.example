# Optional External Webhook URL for Leads (Google Sheets Web App / Zapier / Make / CRM / Slack)
# Leave empty to store leads exclusively on local server disk (data/leads.jsonl)
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional custom leads storage directory (defaults to ./data)
LEADS_STORAGE_DIR=

# Optional Analytics ID (e.g. Cloudflare Web Analytics token)
PUBLIC_ANALYTICS_ID=

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Solution from '../components/Solution.astro';
import Features from '../components/Features.astro';
import Architecture from '../components/Architecture.astro';
import TestingValidation from '../components/TestingValidation.astro';
import DeveloperExperience from '../components/DeveloperExperience.astro';
import DocumentationLinks from '../components/DocumentationLinks.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import EnquiryModal from '../components/EnquiryModal.astro';
---

<Layout>
  <!-- Sticky Navigation -->
  <Navbar />

  <!-- Main Website Flow -->
  <main id="main-content" class="flex-1">
    <!-- Section B: Hero -->
    <Hero />

    <!-- Section C: Problem -->
    <Problem />

    <!-- Section D: Solution -->
    <Solution />

    <!-- Section E: Features -->
    <Features />

    <!-- Section F: Architecture -->
    <Architecture />

    <!-- Section G: Testing & Validation -->
    <TestingValidation />

    <!-- Section H: Developer Experience -->
    <DeveloperExperience />

    <!-- Section I: Documentation Links -->
    <DocumentationLinks />

    <!-- Section J: Early Access -->
    <EarlyAccess />

    <!-- Section K: Frequently Asked Questions -->
    <FAQ />

    <!-- Section L: Final Call To Action -->
    <FinalCTA />
  </main>

  <!-- Section M: Footer -->
  <Footer />

  <!-- Centralized Enquiry Modal (Supports Tally Embed + Interactive Preview) -->
  <EnquiryModal />
</Layout>


---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EnquiryModal from '../components/EnquiryModal.astro';
import { siteConfig } from '../config/siteConfig';
---

<Layout
  title={`Privacy Policy — ${siteConfig.name}`}
  description="Privacy practices for Django SaaS Foundation website visitors and commercial enquiry submissions."
>
  <Navbar />

  <main id="main-content" class="flex-1 py-16 sm:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href="/" class="text-xs font-mono text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1.5 mb-4">
        ← Back to Homepage
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Privacy & Data Handling Notice
      </h1>
      <p class="text-sm text-slate-400 mt-2 font-mono">
        Effective: November 2026 · Django SaaS Foundation
      </p>
    </div>

    <div class="prose prose-invert max-w-none space-y-6 text-sm text-slate-300 leading-relaxed">
      
      <section class="p-6 rounded-2xl bg-surface-card border border-surface-border">
        <h2 class="text-lg font-bold text-white mb-2">1. Principle of Data Minimization</h2>
        <p>
          We build developer infrastructure and respect developer privacy. We do not operate invasive advertising tracking pixels, cross-site trackers, or third-party data broker integrations.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-surface-card border border-surface-border">
        <h2 class="text-lg font-bold text-white mb-2">2. Customer Enquiry Submissions</h2>
        <p>
          When you submit an early-access request, commercial licensing enquiry, or general contact message through our enquiry forms, we collect the information you voluntarily provide:
        </p>
        <ul class="list-disc list-inside mt-2 space-y-1 text-slate-400">
          <li>Full Name and Email Address</li>
          <li>Enquiry Type (Early Access, Commercial Licensing, General)</li>
          <li>Organization Name and Role (e.g., Developer, Agency, Founder)</li>
          <li>Project specifications or custom questions submitted in the message body</li>
        </ul>
        <p class="mt-3">
          This data is processed exclusively to evaluate your SaaS requirements, grant early access repositories, or provide licensing terms. We will never sell, rent, or distribute your email address to marketers.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-surface-card border border-surface-border">
        <h2 class="text-lg font-bold text-white mb-2">3. Form Management via Tally</h2>
        <p>
          Our public enquiries are collected securely using <a href="https://tally.so" target="_blank" rel="noopener noreferrer" class="text-emerald-400 underline">Tally.so</a>. Submissions are encrypted in transit over HTTPS and stored according to strict European GDPR data protection standards.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-surface-card border border-surface-border">
        <h2 class="text-lg font-bold text-white mb-2">4. Analytics & Telemetry</h2>
        <p>
          This website uses static-first hosting and privacy-friendly, anonymized traffic measurement without third-party cookies or fingerprinting.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-surface-card border border-surface-border">
        <h2 class="text-lg font-bold text-white mb-2">5. Contact & Data Deletion Requests</h2>
        <p>
          If you have submitted an enquiry and wish to have your contact details updated or permanently deleted from our records, please open an issue or contact the project maintainer via the <a href={siteConfig.links.githubRepo} class="text-emerald-400 underline" target="_blank" rel="noopener noreferrer">GitHub repository</a>.
        </p>
      </section>

    </div>
  </main>

  <Footer />
  <EnquiryModal />
</Layout>


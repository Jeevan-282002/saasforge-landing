---
import { siteConfig } from '../config/siteConfig';
---

<section class="py-20 md:py-28 bg-gradient-to-b from-[#060911] via-surface-base to-[#050811] relative overflow-hidden border-t border-surface-border">
  <!-- Glowing background effect -->
  <div class="absolute inset-0 bg-grid-pattern opacity-20 pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[300px] bg-gradient-to-r from-emerald-500/15 via-teal-500/10 to-indigo-600/15 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/70 border border-emerald-800/40 text-emerald-400 text-xs font-mono font-medium mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      Ready to Accelerate Your Launch?
    </div>

    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
      Your Next SaaS Product Starts Here.
    </h2>

    <p class="mt-5 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto">
      Spend less time rebuilding infrastructure. Spend more time building products.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={siteConfig.links.githubRepo}
        target="_blank"
        rel="noopener noreferrer"
        data-track="final_cta_github_click"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl font-semibold text-slate-950 bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-xl shadow-emerald-500/25 transition-all text-base active:scale-95"
      >
        <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>Explore GitHub</span>
      </a>

      <button
        type="button"
        data-open-enquiry
        data-enquiry-type="early-access"
        data-track="final_cta_early_access_click"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold text-slate-200 hover:text-white bg-surface-card hover:bg-surface-cardHover border border-surface-border hover:border-slate-600 transition-all text-base"
      >
        <span>Request Early Access</span>
      </button>
    </div>

    <!-- Quick Repository Metrics Indicator -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-xs font-mono text-slate-400">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> 152 Automated Tests Verified
      </span>
      <span class="text-slate-600">•</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span> PostgreSQL 17 + Redis 7
      </span>
      <span class="text-slate-600">•</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Ruff: 0 Errors
      </span>
    </div>

  </div>
</section>


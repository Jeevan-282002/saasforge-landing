---
import { siteConfig } from '../config/siteConfig';

const metrics = siteConfig.testingMetrics;
---

<section id="testing" class="py-20 md:py-28 bg-surface-base relative border-t border-surface-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium mb-4">
        <span>Transparent Verification Results</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Tested. Validated. Documented.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        Every claim backed by actual test outputs from automated CI/CD validation suites. No hypothetical readiness claims.
      </p>
    </div>

    <!-- Test Results Metric Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      
      <!-- Metric 1: Config A -->
      <div class="glass-card p-6 rounded-2xl border border-surface-border bg-surface-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold">Configuration A</span>
            <span class="text-xs font-mono text-slate-500">Full Suite</span>
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-extrabold text-white font-mono">{metrics.configA.passed}</span>
            <span class="text-sm text-emerald-400 font-semibold font-mono">Passed</span>
            <span class="text-xs text-slate-500 font-mono">/ {metrics.configA.skipped} Skipped</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Full test suite covering live PostgreSQL 17 tenant provisioning, advisory locks, and cross-database isolation.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-surface-border/60 text-[11px] font-mono text-slate-400">
          * 2 skips require live CREATEDB root privileges
        </div>
      </div>

      <!-- Metric 2: Config B -->
      <div class="glass-card p-6 rounded-2xl border border-surface-border bg-surface-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-teal-400 uppercase tracking-wider font-semibold">Configuration B</span>
            <span class="text-xs font-mono text-slate-500">Foundation Only</span>
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-extrabold text-white font-mono">{metrics.configB.passed}</span>
            <span class="text-sm text-teal-400 font-semibold font-mono">Passed</span>
            <span class="text-xs text-slate-500 font-mono">/ {metrics.configB.skipped} Skipped</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Core-only mode executed with <code>DJANGO_ENABLE_DEMO_APPS=false</code>, validating zero coupling to demo apps.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-surface-border/60 text-[11px] font-mono text-slate-400">
          * 11 skips correspond to disabled demo endpoints
        </div>
      </div>

      <!-- Metric 3: Fresh Migrations -->
      <div class="glass-card p-6 rounded-2xl border border-surface-border bg-surface-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-indigo-400 uppercase tracking-wider font-semibold">Database Schema</span>
            <span class="text-xs font-mono text-slate-500">Fresh Migrations</span>
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-extrabold text-white font-mono">{metrics.freshMigrations.coreTables}</span>
            <span class="text-sm text-indigo-400 font-semibold font-mono">Core Tables</span>
            <span class="text-xs text-slate-500 font-mono">/ {metrics.freshMigrations.demoTables} Demo</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Clean migration topology. Core SaaS tables are strictly isolated from optional consumer sample applications.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-surface-border/60 text-[11px] font-mono text-slate-400">
          Zero residual demo schema pollution
        </div>
      </div>

      <!-- Metric 4: Isolation Checks -->
      <div class="glass-card p-6 rounded-2xl border border-surface-border bg-surface-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold">Tenant Isolation</span>
            <span class="text-xs font-mono text-slate-500">Zero Cross-Leakage</span>
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-extrabold text-emerald-400 font-mono">{metrics.isolationChecks.passed}/{metrics.isolationChecks.total}</span>
            <span class="text-sm text-white font-semibold font-mono">Passed</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Rigorous cross-tenant mutation tests verifying that Tenant A cannot query, update, or delete Tenant B records.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-surface-border/60 text-[11px] font-mono text-slate-400">
          Physical database-per-tenant verification
        </div>
      </div>

      <!-- Metric 5: Router Checks -->
      <div class="glass-card p-6 rounded-2xl border border-surface-border bg-surface-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-semibold">Database Router</span>
            <span class="text-xs font-mono text-slate-500">Context Routing</span>
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-extrabold text-cyan-400 font-mono">{metrics.databaseRouterChecks.passed}/{metrics.databaseRouterChecks.total}</span>
            <span class="text-sm text-white font-semibold font-mono">Passed</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Verification of <code>TenantDatabaseRouter</code> determining database target based on app label and active thread context.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-surface-border/60 text-[11px] font-mono text-slate-400">
          Deterministic app label routing
        </div>
      </div>

      <!-- Metric 6: Ruff Code Quality -->
      <div class="glass-card p-6 rounded-2xl border border-surface-border bg-surface-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-amber-400 uppercase tracking-wider font-semibold">Code Hygiene</span>
            <span class="text-xs font-mono text-slate-500">Ruff Linter</span>
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-extrabold text-white font-mono">{metrics.codeQuality.errors}</span>
            <span class="text-sm text-emerald-400 font-semibold font-mono">Errors</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Full compliance with PEP 8, modern Python typing, strict import sorting, and zero security linter violations.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-surface-border/60 text-[11px] font-mono text-slate-400">
          Clean Python 3.13+ syntax & strict standards
        </div>
      </div>

    </div>

    <!-- Responsible Engineering Disclaimer -->
    <div class="p-5 rounded-xl bg-surface-card border border-surface-border text-xs text-slate-400 max-w-4xl mx-auto flex items-start gap-3">
      <svg class="w-5 h-5 text-slate-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <strong class="text-slate-300 font-semibold block mb-0.5">Engineering Notice on Test Validation:</strong>
        Passing automated test suites validates functional implementation and isolation mechanics under the tested configurations. Passing tests alone do not constitute a guarantee of production readiness or infinite enterprise scalability for your specific workload. Developers should execute their own workload-specific load tests, security reviews, and deployment audits before launching commercial workloads.
      </div>
    </div>

  </div>
</section>


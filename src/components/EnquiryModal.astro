---
import { siteConfig } from '../config/siteConfig';

const rawEmbedUrl = import.meta.env.PUBLIC_TALLY_EMBED_URL || "";
const rawFormUrl = import.meta.env.PUBLIC_TALLY_FORM_URL || "";

// Direct public URL for opening form in a new window/tab
const directUrl = rawFormUrl || siteConfig.tally.directUrl || "https://tally.so/r/laBxAB";

// Embed URL for responsive inline iframe embed
const embedUrl = rawEmbedUrl ||
  siteConfig.tally.embedUrl ||
  (directUrl.includes('/r/') ? directUrl.replace('/r/', '/embed/') : "https://tally.so/embed/laBxAB");

const isFormConfigured = Boolean(embedUrl || directUrl);
---

<!-- Global Enquiry Modal Dialog -->
<div
  id="enquiry-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-headline"
>
  <div class="relative w-full max-w-2xl bg-surface-base border border-surface-border rounded-2xl shadow-2xl p-6 sm:p-8 my-8 overflow-hidden">
    <!-- Ambient top glow -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-32 bg-emerald-500/10 blur-3xl pointer-events-none"></div>

    <!-- Close button -->
    <button
      id="modal-close-btn"
      type="button"
      class="absolute top-5 right-5 text-slate-400 hover:text-white bg-surface-raised hover:bg-surface-border p-2 rounded-lg transition-colors"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-800/40 text-emerald-400 text-xs font-medium mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Direct Product Access
      </div>
      <h3 id="modal-headline" class="text-2xl font-bold text-white tracking-tight">
        Connect With the Product Owner
      </h3>
      <p class="text-slate-400 text-sm mt-1">
        Request early access, discuss commercial licensing, or share your SaaS project requirements.
      </p>
    </div>

    <!-- Tally Form Integration or Development Preview -->
    {isFormConfigured ? (
      <div class="space-y-4">
        <div class="relative w-full min-h-[480px] rounded-xl overflow-hidden bg-surface-card border border-surface-border">
          <!-- Ambient loader indicator displayed while iframe initializes -->
          <div id="tally-loading" class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-slate-400 pointer-events-none">
            <div class="w-8 h-8 rounded-full border-2 border-emerald-500/20 border-t-emerald-400 animate-spin"></div>
            <span class="text-xs">Loading enquiry form...</span>
          </div>
          <iframe
            id="tally-iframe"
            data-tally-src={`${embedUrl}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
            loading="lazy"
            width="100%"
            height="500"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title="Django SaaS Foundation Enquiry Form"
            class="w-full relative z-10"
            onload="document.getElementById('tally-loading')?.classList.add('hidden')"
          ></iframe>
        </div>
        <div class="flex items-center justify-between text-xs text-slate-400 pt-2">
          <span>Having trouble loading?</span>
          <a
            href={directUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-emerald-400 hover:text-emerald-300 font-medium underline inline-flex items-center gap-1"
          >
            Open form in new window
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="space-y-6">
        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-sm">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <strong class="font-semibold block text-amber-300">Development Configuration Notice</strong>
              <p class="text-xs text-amber-200/90 mt-1">
                <code class="px-1.5 py-0.5 rounded bg-black/40 text-amber-300">PUBLIC_TALLY_FORM_URL</code> is not configured.
                Submissions will not be sent to a live endpoint. Below is the interactive UI preview of the required enquiry fields.
              </p>
            </div>
          </div>
        </div>

        <form id="preview-enquiry-form" class="space-y-4 text-left" onsubmit="event.preventDefault(); window.handlePreviewSubmit(event);">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="preview-name" class="block text-xs font-medium text-slate-300 mb-1">
                Full Name <span class="text-emerald-400">*</span>
              </label>
              <input
                type="text"
                id="preview-name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-3.5 py-2.5 rounded-lg bg-surface-card border border-surface-border text-slate-100 placeholder-slate-500 text-sm focus:border-emerald-500 transition-colors"
              />
            </div>
            <div>
              <label for="preview-email" class="block text-xs font-medium text-slate-300 mb-1">
                Email Address <span class="text-emerald-400">*</span>
              </label>
              <input
                type="email"
                id="preview-email"
                name="email"
                required
                placeholder="jane@company.com"
                class="w-full px-3.5 py-2.5 rounded-lg bg-surface-card border border-surface-border text-slate-100 placeholder-slate-500 text-sm focus:border-emerald-500 transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="preview-enquiry-type" class="block text-xs font-medium text-slate-300 mb-1">
                Enquiry Type <span class="text-emerald-400">*</span>
              </label>
              <select
                id="preview-enquiry-type"
                name="enquiryType"
                required
                class="w-full px-3.5 py-2.5 rounded-lg bg-surface-card border border-surface-border text-slate-100 text-sm focus:border-emerald-500 transition-colors"
              >
                <option value="early-access">Request Early Access</option>
                <option value="commercial-licensing">Commercial Licensing Enquiry</option>
                <option value="general-question">General Question</option>
                <option value="partnership">Partnership / Collaboration</option>
              </select>
            </div>
            <div>
              <label for="preview-role" class="block text-xs font-medium text-slate-300 mb-1">
                I am a: <span class="text-emerald-400">*</span>
              </label>
              <select
                id="preview-role"
                name="role"
                required
                class="w-full px-3.5 py-2.5 rounded-lg bg-surface-card border border-surface-border text-slate-100 text-sm focus:border-emerald-500 transition-colors"
              >
                <option value="individual-developer">Individual Developer</option>
                <option value="freelancer">Freelancer</option>
                <option value="startup-founder">Startup Founder</option>
                <option value="software-agency">Software Agency</option>
                <option value="engineering-team">Engineering Team</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <div>
            <label for="preview-org" class="block text-xs font-medium text-slate-300 mb-1">
              Organization Name <span class="text-slate-500 font-normal">(Optional)</span>
            </label>
            <input
              type="text"
              id="preview-org"
              name="organization"
              placeholder="Acme Inc. or Project Name"
              class="w-full px-3.5 py-2.5 rounded-lg bg-surface-card border border-surface-border text-slate-100 placeholder-slate-500 text-sm focus:border-emerald-500 transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">
              Which capabilities interest you most?
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
              <label class="flex items-center gap-2 p-2 rounded bg-surface-card border border-surface-border text-slate-300 cursor-pointer hover:border-slate-600">
                <input type="checkbox" name="capabilities" value="multi-tenancy" class="rounded text-emerald-500 bg-surface-raised border-slate-700" checked />
                <span>Multi-tenancy</span>
              </label>
              <label class="flex items-center gap-2 p-2 rounded bg-surface-card border border-surface-border text-slate-300 cursor-pointer hover:border-slate-600">
                <input type="checkbox" name="capabilities" value="rbac" class="rounded text-emerald-500 bg-surface-raised border-slate-700" checked />
                <span>4-Tier RBAC</span>
              </label>
              <label class="flex items-center gap-2 p-2 rounded bg-surface-card border border-surface-border text-slate-300 cursor-pointer hover:border-slate-600">
                <input type="checkbox" name="capabilities" value="quota-engine" class="rounded text-emerald-500 bg-surface-raised border-slate-700" />
                <span>Quota Engine</span>
              </label>
              <label class="flex items-center gap-2 p-2 rounded bg-surface-card border border-surface-border text-slate-300 cursor-pointer hover:border-slate-600">
                <input type="checkbox" name="capabilities" value="audit-logging" class="rounded text-emerald-500 bg-surface-raised border-slate-700" />
                <span>Audit Logging</span>
              </label>
              <label class="flex items-center gap-2 p-2 rounded bg-surface-card border border-surface-border text-slate-300 cursor-pointer hover:border-slate-600">
                <input type="checkbox" name="capabilities" value="celery-outbox" class="rounded text-emerald-500 bg-surface-raised border-slate-700" />
                <span>Celery & Outbox</span>
              </label>
              <label class="flex items-center gap-2 p-2 rounded bg-surface-card border border-surface-border text-slate-300 cursor-pointer hover:border-slate-600">
                <input type="checkbox" name="capabilities" value="complete-foundation" class="rounded text-emerald-500 bg-surface-raised border-slate-700" checked />
                <span>Complete Core</span>
              </label>
            </div>
          </div>

          <div>
            <label for="preview-planning" class="block text-xs font-medium text-slate-300 mb-1">
              What are you planning to build?
            </label>
            <input
              type="text"
              id="preview-planning"
              name="planning"
              placeholder="e.g. B2B Analytics SaaS, Healthcare Portal, Multi-tenant CRM"
              class="w-full px-3.5 py-2.5 rounded-lg bg-surface-card border border-surface-border text-slate-100 placeholder-slate-500 text-sm focus:border-emerald-500 transition-colors"
            />
          </div>

          <div>
            <label for="preview-message" class="block text-xs font-medium text-slate-300 mb-1">
              Additional Message or Specific Questions
            </label>
            <textarea
              id="preview-message"
              name="message"
              rows="3"
              placeholder="Tell us about your timeline, expected tenant volumes, or questions regarding licensing."
              class="w-full px-3.5 py-2.5 rounded-lg bg-surface-card border border-surface-border text-slate-100 placeholder-slate-500 text-sm focus:border-emerald-500 transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Dev notice on submit -->
          <div id="preview-feedback" class="hidden p-3 rounded-lg text-xs font-medium"></div>

          <button
            type="submit"
            class="w-full py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.99]"
          >
            Submit Enquiry (Preview Mode)
          </button>
        </form>
      </div>
    )}

    <!-- Privacy Notice -->
    <div class="mt-6 pt-4 border-t border-surface-border flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>We respect your privacy. Submissions are never sold or shared.</span>
      </div>
      <a href="/privacy" class="text-slate-400 hover:text-slate-300 underline">Privacy Policy</a>
    </div>
  </div>
</div>

<!-- Modal Script Handling -->
<script>
  // Ensure script runs on client side
  const modal = document.getElementById('enquiry-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const previewFeedback = document.getElementById('preview-feedback');

  function initTallyEmbed() {
    const iframe = document.getElementById('tally-iframe') as HTMLIFrameElement | null;
    if (!iframe) return;

    // If iframe is already initialized and active, do not reset it
    if (iframe.dataset.tallyEmbedWidgetInitialized === '1' && iframe.src) {
      return;
    }

    const triggerTally = () => {
      if (typeof (window as any).Tally !== 'undefined') {
        (window as any).Tally.loadEmbeds();
      } else if (!iframe.src && iframe.dataset.tallySrc) {
        // Direct fallback: if Tally script is blocked or unreachable
        iframe.src = iframe.dataset.tallySrc;
      }
    };

    const tallyScriptSrc = 'https://tally.so/widgets/embed.js';
    const existingScript = document.querySelector(`script[src="${tallyScriptSrc}"]`);

    if (typeof (window as any).Tally !== 'undefined') {
      (window as any).Tally.loadEmbeds();
    } else if (!existingScript) {
      const script = document.createElement('script');
      script.src = tallyScriptSrc;
      script.async = true;
      script.onload = triggerTally;
      script.onerror = triggerTally;
      document.body.appendChild(script);
    } else {
      existingScript.addEventListener('load', triggerTally, { once: true });
      existingScript.addEventListener('error', triggerTally, { once: true });
    }

    // Safety fallback: if after 400ms src is not set by IntersectionObserver, set it directly
    setTimeout(() => {
      if (!iframe.src && iframe.dataset.tallySrc) {
        if (typeof (window as any).Tally !== 'undefined') {
          (window as any).Tally.loadEmbeds();
        } else {
          iframe.src = iframe.dataset.tallySrc;
        }
      }
    }, 400);
  }

  function openModal(enquiryType?: string) {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    // If preview form exists, set default type
    const typeSelect = document.getElementById('preview-enquiry-type') as HTMLSelectElement | null;
    if (typeSelect && enquiryType) {
      typeSelect.value = enquiryType;
    }

    // Initialize Tally embed when modal opens
    initTallyEmbed();
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Attach to all elements with [data-open-enquiry]
  document.querySelectorAll('[data-open-enquiry]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const enquiryType = btn.getAttribute('data-enquiry-type') || 'early-access';
      openModal(enquiryType);
      (window as any).trackEvent?.('enquiry_modal_opened', { enquiryType });
    });
  });

  // Preview form handler
  (window as any).handlePreviewSubmit = (event: Event) => {
    event.preventDefault();
    if (previewFeedback) {
      previewFeedback.classList.remove('hidden');
      previewFeedback.className = 'p-3 rounded-lg text-xs font-medium bg-emerald-950/60 border border-emerald-800 text-emerald-300';
      previewFeedback.innerHTML = `
        <strong>Preview Validated:</strong> Form fields captured correctly in development mode.
        To route enquiries to your inbox & Google Sheets, configure <code class="px-1 py-0.5 rounded bg-black/40 text-emerald-200">PUBLIC_TALLY_FORM_URL</code> in your deployment environment variables.
      `;
    }
    (window as any).trackEvent?.('preview_form_submitted');
  };
</script>

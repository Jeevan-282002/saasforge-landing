---
import { siteConfig } from '../config/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#050811] border-t border-surface-border text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12 mb-12">
      
      <!-- Brand & Description (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="#" class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center">
            <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
          </div>
          <span class="text-base font-bold text-white tracking-tight">Django SaaS Foundation</span>
        </a>

        <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
          {siteConfig.description}
        </p>

        <div class="text-xs text-slate-500 font-mono">
          <span>Maintained independently by </span>
          <a
            href={siteConfig.author.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-emerald-400 hover:underline"
          >
            @{siteConfig.author.github}
          </a>
        </div>
      </div>

      <!-- Navigation & Features -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-3">
          Capabilities
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#features" class="hover:text-white transition-colors">Multi-Tenant Routing</a></li>
          <li><a href="#features" class="hover:text-white transition-colors">PostgreSQL DB Isolation</a></li>
          <li><a href="#features" class="hover:text-white transition-colors">4-Tier RBAC</a></li>
          <li><a href="#features" class="hover:text-white transition-colors">QuotaRegistry Engine</a></li>
          <li><a href="#features" class="hover:text-white transition-colors">Celery Transactional Outbox</a></li>
          <li><a href="#testing" class="hover:text-white transition-colors">Automated Verification</a></li>
        </ul>
      </div>

      <!-- Documentation & Technical Source -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-3">
          Documentation
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href={siteConfig.links.docs.readme} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">README Overview</a></li>
          <li><a href={siteConfig.links.docs.architecture} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">System Architecture</a></li>
          <li><a href={siteConfig.links.docs.multiTenancy} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Multi-Tenancy Guide</a></li>
          <li><a href={siteConfig.links.docs.subscriptionsQuotas} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Subscriptions & Quotas</a></li>
          <li><a href={siteConfig.links.docs.developerGuide} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Developer Setup</a></li>
          <li><a href={siteConfig.links.docs.securityAudit} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Security Audit</a></li>
        </ul>
      </div>

      <!-- Connect & Enquiries -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-3">
          Connect & Licensing
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <button
              type="button"
              data-open-enquiry
              data-enquiry-type="early-access"
              class="hover:text-white transition-colors text-left cursor-pointer"
            >
              Request Early Access
            </button>
          </li>
          <li>
            <button
              type="button"
              data-open-enquiry
              data-enquiry-type="commercial-licensing"
              class="hover:text-white transition-colors text-left cursor-pointer"
            >
              Commercial Licensing
            </button>
          </li>
          <li>
            <button
              type="button"
              data-open-enquiry
              data-enquiry-type="general-question"
              class="hover:text-white transition-colors text-left cursor-pointer"
            >
              General Enquiry
            </button>
          </li>
          <li>
            <a
              href={siteConfig.links.githubIssues}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors inline-flex items-center gap-1"
            >
              GitHub Issues
              <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="/privacy" class="hover:text-white transition-colors">Privacy Notice</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 border-t border-surface-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
        <span>&copy; {currentYear} Django SaaS Foundation. All rights reserved.</span>
        <span class="hidden sm:inline text-slate-700">|</span>
        <span>Independent open-source/source-available product. Not an official Django or Django Software Foundation product.</span>
      </div>
      
      <div class="flex items-center gap-4">
        <a href={siteConfig.links.githubRepo} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Source Repository
        </a>
        <a href="#main-content" class="hover:text-white transition-colors">
          Back to Top ↑
        </a>
      </div>
    </div>

  </div>
</footer>


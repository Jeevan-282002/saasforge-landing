---
const features = [
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
    title: "Multi-Tenant Architecture",
    description: "Support for subdomain-based routing (e.g. acme.app.com) and fallback X-Organization header routing for API clients.",
    benefit: "Seamless onboarding of enterprise customers with custom subdomains or headless API clients without code divergence.",
    category: "Architecture"
  },
  {
    icon: `<svg class="w-6 h-6 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" /></svg>`,
    title: "Database Isolation",
    description: "Physical PostgreSQL database separation per tenant rather than relying solely on error-prone WHERE organization_id = ? row filtering.",
    benefit: "Guarantees zero cross-tenant query contamination and simplifies compliance, GDPR tenant deletion, and per-tenant backups.",
    category: "Security"
  },
  {
    icon: `<svg class="w-6 h-6 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    title: "Role-Based Access Control",
    description: "Built-in 4-tier hierarchy: Owner, Admin, Member, and Viewer, enforced deterministically across endpoints.",
    benefit: "Admins cannot demote Owners; Viewers cannot mutate records. Pre-tested permission rules prevent privilege escalation.",
    category: "Authorization"
  },
  {
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    title: "Organization Management",
    description: "Complete tenant lifecycle management: organization creation, slug validation, membership roster, and metadata tracking.",
    benefit: "Users can belong to multiple organizations with distinct roles in each, switching contexts via standard headers.",
    category: "Core SaaS"
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    title: "Organization Invitations",
    description: "Cryptographically generated invitation tokens with automatic expiry handling and secure email acceptance flows.",
    benefit: "Eliminates invitation-spoofing vectors and provides clean team collaboration out of the box.",
    category: "Core SaaS"
  },
  {
    icon: `<svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>`,
    title: "Audit Logging",
    description: "Centralized compliance logging that captures user actions, IP addresses, timestamps, and target resources.",
    benefit: "Sensitive fields (passwords, tokens) are automatically redacted in audit payloads to maintain security compliance.",
    category: "Compliance"
  },
  {
    icon: `<svg class="w-6 h-6 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>`,
    title: "Subscription Plan Foundation",
    description: "Structured Free, Pro, and Business tiers ready for payment gateway integration (Stripe, Lemon Squeezy, Paddle).",
    benefit: "Centralizes subscription status, renewal cycles, and pricing tier metadata without polluting tenant schemas.",
    category: "Billing"
  },
  {
    icon: `<svg class="w-6 h-6 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" /></svg>`,
    title: "Usage Limits and Tracking",
    description: "Extensible QuotaRegistry that evaluates real-time counts against active plan limits before mutations.",
    benefit: "Plug in custom counters (e.g. max seats, API calls, storage) with a single lambda registration call.",
    category: "Billing"
  },
  {
    icon: `<svg class="w-6 h-6 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: "Celery Background Processing",
    description: "Asynchronous task execution using Celery 5.4+ with Redis 7 as broker, coupled with a Transactional Outbox.",
    benefit: "Tasks run with tenant context awareness, preventing cross-tenant database writes during async execution.",
    category: "Infrastructure"
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    title: "Database Routing",
    description: "Custom TenantDatabaseRouter dynamically routes ORM queries to central or tenant databases based on app label.",
    benefit: "Standard Django ORM queries like Project.objects.all() automatically query the correct tenant database.",
    category: "Architecture"
  },
  {
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`,
    title: "Docker Support",
    description: "Production-ready Docker Compose v2 environment with PostgreSQL 17, Redis 7, Celery worker, and Celery beat.",
    benefit: "Spin up the complete multi-tenant infrastructure locally with a single docker compose up command.",
    category: "DevOps"
  },
  {
    icon: `<svg class="w-6 h-6 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`,
    title: "Security-Oriented Configuration",
    description: "Pre-configured CSP, HSTS, Permissions-Policy, X-Frame-Options: DENY, and request correlation IDs.",
    benefit: "Passes Django check --deploy security audits with zero critical warnings out of the box.",
    category: "Security"
  }
];
---

<section id="features" class="py-20 md:py-28 bg-surface-base relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium mb-4">
        <span>Verified Technical Capabilities</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Engineered for Serious B2B SaaS
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        Every capability listed below is implemented in the repository, verified by automated tests, and documented for production use.
      </p>
    </div>

    <!-- 12 Feature Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="glass-card glass-card-hover p-6 rounded-2xl border border-surface-border bg-surface-card flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl bg-surface-raised border border-surface-border flex items-center justify-center group-hover:border-emerald-500/40 transition-colors">
                <Fragment set:html={feature.icon} />
              </div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface-raised border border-surface-border text-slate-400">
                {feature.category}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-emerald-300 transition-colors">
              {feature.title}
            </h3>

            <p class="text-sm text-slate-300 leading-relaxed mb-4">
              {feature.description}
            </p>
          </div>

          <div class="pt-4 border-t border-surface-border/60">
            <span class="block text-[11px] font-mono uppercase tracking-wider text-emerald-400 font-semibold mb-1">
              Developer Benefit:
            </span>
            <p class="text-xs text-slate-400 leading-normal">
              {feature.benefit}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

